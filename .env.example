APP_ENV=local
APP_TIME_ZONE=America/Los_Angeles
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8080
SPRING_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
ALLOWED_ORIGINS=http://localhost:5173
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_DEFAULT_USER=local-user-1
LOCAL_AUTH_DEFAULT_ROLE=CHATBOT_USER
H2_MODE=file
H2_DATABASE_PATH=./data/clinconnect-poc
H2_CONSOLE_ENABLED=true
SESSION_TTL_SECONDS=1800
MAX_PROCESSED_MESSAGES_PER_SESSION=20
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=20
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60
AI_MAX_RETRIES_FOR_INVALID_STRUCTURED_OUTPUT=1
AI_LOG_RAW_PROMPTS=false
TONIGHT_START_LOCAL=17:00
# Wall-clock-relative "who is on call" coverage data for manual/live sessions only.
# Never sourced by `mvn test`, so it never affects deterministic test fixtures.
SEED_LIVE_DEMO_COVERAGE=true